# Official API contract: discovery, source values, errors and revision semantics.
require vgi

require-env BOJ_WORKER

statement ok
LOAD json;

statement ok
ATTACH 'boj' (TYPE vgi, LOCATION '{BOJ_WORKER}');

# curated discovery
query T
SELECT count(*) FROM boj.main.datasets();
----
10

# series discovery
query T
SELECT series_code FROM boj.main.series('IR01') ORDER BY series_code;
----
MADR1M
MADR1Z@D

# localized metadata
query T
SELECT name_ja FROM boj.main.series('IR01', language := 'jp', max_rows := 1);
----
金利

# hierarchy headings
query TTT
SELECT series_code, layer1, layer2 FROM boj.main.layers('IR01');
----
NULL	1	0

# composed: series grouped under layers headings (SERIES_BY_HEADING example)
query TTTTI
SELECT top.name AS section, sub.name AS subsection, s.frequency, CASE WHEN sub.name IS NULL THEN s.layer1::VARCHAR ELSE s.layer1 || ',' || s.layer2 END AS layer, count(*) AS series_count FROM boj.main.series('FM08') AS s JOIN boj.main.layers('FM08') AS top ON top.layer1 = s.layer1 AND top.layer2 = 0 LEFT JOIN boj.main.layers('FM08') AS sub ON sub.layer1 = s.layer1 AND sub.layer2 = s.layer2 AND sub.layer2 <> 0 AND sub.layer3 = 0 GROUP BY ALL ORDER BY layer;
----
Fixture heading	NULL	DAILY	1	2

# composed: layer_observations joined to observations on the native period
query TTT
SELECT c.series_code, c.period, b.value FROM boj.main.layer_observations('FM01', 'D', '1', start_period := '202403', end_period := '202403') AS c JOIN boj.main.observations('IR01', ['MADR1Z@D'], start_period := '202403', end_period := '202403') AS b USING (period) WHERE c.value IS NOT NULL ORDER BY c.series_code, c.period;
----
MADR1Z@D	20240301	0.3
MADR1Z@D	20240303	0.35
OTHERD	20240301	0.3
OTHERD	20240303	0.35

# automatic pages
query TT
SELECT count(*), count(value) FROM boj.main.observations('IR01', ['MADR1Z@D', 'OTHERD']);
----
6	4

# source numeric text
query TT
SELECT period, value_text FROM boj.main.observations('IR01', ['MADR1Z@D'], start_period := '202401', end_period := '202401') ORDER BY period;
----
20240101	0.30
20240102	NULL
20240103	0.35

# cap across pages
query T
SELECT count(*) FROM boj.main.observations('IR01', ['MADR1Z@D', 'OTHERD'], max_rows := 4);
----
4

# layer selection
query T
SELECT count(*) FROM boj.main.layer_observations('IR01', 'D', '1,1');
----
6

# empty data
query T
SELECT count(*) FROM boj.main.observations('IR01', ['MADR1Z@D'], start_period := '210001');
----
0

# invalid array alignment
statement error
SELECT * FROM boj.main.observations('BADARRAY', ['MADR1Z@D']);
----
lengths

# stalled source cursor
statement error
SELECT * FROM boj.main.observations('STALLED', ['MADR1Z@D']);
----
stalled

# repeated page
statement error
SELECT * FROM boj.main.observations('REPEAT', ['MADR1Z@D','OTHERD']);
----
repeated

# application API error
statement error
SELECT * FROM boj.main.observations('APIERROR', ['MADR1Z@D']);
----
M181013E

# wrong period format
statement error
SELECT * FROM boj.main.observations('IR01', ['MADR1Z@D'], start_period := '20240101');
----
YYYYMM

# invalid quarter
statement error
SELECT * FROM boj.main.layer_observations('IR01', 'Q', '1', start_period := '202405');
----
frequency

statement ok
DETACH boj;
